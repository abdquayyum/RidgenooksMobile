{
  "expo": {
    "name": "Ridgenooks",
    "slug": "ridgenooks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-ios.png",
    "scheme": "ridgenooksmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ridgenooks.app",
      "buildNumber": "13",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/logo_transparent.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ridgenooks.app",
      "versionCode": 13,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/logo_transparent.png",
          "imageWidth": 200
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.ridgenooks.app",
          "enableGooglePay": false
        }
      ],
      "expo-secure-store",
      "./withDisableStrictConcurrency.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6422332d-c9a9-4fbd-8e6a-a119d7c0e49f"
      }
    },
    "splash": {
      "image": "./assets/logo_transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    }
  }
}